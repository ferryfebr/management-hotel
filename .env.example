APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jayapura

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Token rahasia route deploy (migration tanpa SSH). Gemerasi acak, JANGAN commit ke Git publik.
# Kosongkan di production kalau DeployController sudah dihapus.
DEPLOY_TOKEN=

# Kredensial akun production untuk ProductionSeeder (bukan DatabaseSeeder development).
# Cukup isi yang dibutuhkan; akun yang kosong dilewati.
PROD_SUPER_ADMIN_NAME=Super Admin
PROD_SUPER_ADMIN_EMAIL=
PROD_SUPER_ADMIN_PASSWORD=
PROD_OWNER_NAME=Owner
PROD_OWNER_EMAIL=
PROD_OWNER_PASSWORD=
PROD_RESEPSIONIS_NAME=Resepsionis
PROD_RESEPSIONIS_EMAIL=
PROD_RESEPSIONIS_PASSWORD=
PROD_ROOM_KEEPER_NAME=Room Keeper
PROD_ROOM_KEEPER_EMAIL=
PROD_ROOM_KEEPER_PASSWORD=

# Kuota hosting & retensi otomatis
HOSTING_QUOTA_MB=2048
HOSTING_RESERVE_MB=300
RETENTION_DB_BUDGET_MB=400
RETENTION_CUSTOMERS_MAX=100000
RETENTION_TRANSACTIONS_MAX=50000
RETENTION_ROOM_LOGS_MAX=100000
RETENTION_ACTIVITY_LOGS_MAX=50000
RETENTION_ARCHIVE_INDEX_MAX=5000
RETENTION_ARCHIVE_BUDGET_MB=250
RETENTION_BACKUP_BUDGET_MB=100
RETENTION_KTP_MAX_FILES=6000
RETENTION_KTP_MAX_MB=600
RETENTION_PROOF_MAX_FILES=5000
RETENTION_PROOF_MAX_MB=300
RETENTION_CUSTOMER_EXPORT_BATCH=300
RETENTION_CUSTOMER_EXPORT_REMINDER=300
RETENTION_APP_LOG_DAYS=14

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
# Production HTTPS: gunakan true untuk cookie Secure dan enkripsi session.
SESSION_ENCRYPT=false
# SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
